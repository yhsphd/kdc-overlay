{
  "name": "kdc-overlay",
  "private": true,
  "version": "2026.3.0",
  "packageManager": "npm@11.12.1",
  "description": "Duo Cup: Korea streaming overlay",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run clean && turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "fix": "npm run lint:fix && npm run format:fix",
    "clean": "rimraf dist/ && turbo run clean",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "turbo": "^2.4.4"
  }
}
